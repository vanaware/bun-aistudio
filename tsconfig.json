{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "@types/bun"]
  },
  "include": [
    "packages/ui/src/**/*",
    "packages/server/src/**/*",
    "packages/ui/tests/**/*",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "packages/server/build"
  ]
}
